# Knowledge-sync secrets — local convenience for `npm run sync:internal` / `npm run sync:wiki`.
#
# Setup (pick ONE; you don't need both):
#   A) Copy this file to `.env.sync.local` (same folder) and paste your key below. It's
#      gitignored, so it never gets committed.
#   B) OR skip the file and set a persistent env var once (Windows):
#        setx SUPABASE_SECRET_KEY "sb_secret_..."
#      An env var set this way always wins over this file.
#
# DONNY_SYNC_URL defaults to the prod endpoint, so you normally only need the key.
# To sync to staging instead, set DONNY_SYNC_URL here (or in your shell) to the
# staging functions URL.

SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# DONNY_SYNC_URL=https://zocahiffooqdybdhguqv.supabase.co/functions/v1/donny-knowledge-sync

# ── Staging headless login (`npm run staging:login`) ────────────────────────────────
# The STAGING service-role key — a DIFFERENT project from the key above
# (dragoncandy-staging, ref mhffqrawgizhprbobcta; the key above is PRODUCTION).
#   Supabase dashboard → dragoncandy-staging → Project Settings → API → service_role
#
# This lets an agent mint a session for a seeded staging test account without anyone
# typing a password, so verifying auth-gated screens no longer needs the founder.
# staging-login.mjs refuses to run if this value looks like the prod key.
STAGING_SUPABASE_SECRET_KEY=REPLACE_ME
