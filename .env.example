# DragonCandy — Environment Variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored
# and takes precedence over the tracked `.env`.
#
# IMPORTANT — point local development at STAGING, never production.
# `src/integrations/supabase/client.ts` refuses to start `npm run dev` if it resolves
# to the production project, because the tracked `.env` and the built-in fallback both
# point there. Staging is a separate, isolated Supabase project with its own data.

# --- Supabase -----------------------------------------------------------------
# Staging project ref: mhffqrawgizhprbobcta   (use this for local development)
# Production project ref: zocahiffooqdybdhguqv (do NOT use locally)
VITE_SUPABASE_URL=https://mhffqrawgizhprbobcta.supabase.co

# The public anon key for the project above. Safe to expose — it is the key the
# browser ships with, and every table is protected by Row Level Security.
#
# NOTE: the code reads VITE_SUPABASE_ANON_KEY. VITE_SUPABASE_PUBLISHABLE_KEY is
# accepted as an alias for older environments, but ANON_KEY is the canonical name.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=mhffqrawgizhprbobcta

# --- Stripe -------------------------------------------------------------------
# Test mode only. Never put a pk_live_ key here — going live requires explicit
# founder approval (see CLAUDE.md).
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Google -------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=
VITE_RECAPTCHA_SITE_KEY=

# --- Escape hatch -------------------------------------------------------------
# Only if you genuinely need to reproduce something against production data.
# Prefer a preview deploy instead. Set it for one session, never commit it:
#   VITE_ALLOW_PROD_FROM_LOCAL=true npm run dev
# VITE_ALLOW_PROD_FROM_LOCAL=true
